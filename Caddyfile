{
    debug
    default_sni {$LAN_IP}
}
(rutas_mensajero) {
    @interno path /a/peer /b/peer
    respond @interno 404

    handle_path /a/* {
        reverse_proxy nodo-a:3000
    }

    handle_path /b/* {
        reverse_proxy nodo-b:3000
    }
}

:80 {
    import rutas_mensajero
}

https://{$LAN_IP} {
    tls internal
    import rutas_mensajero
}